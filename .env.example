# Copy to .env and set every value before starting production.
# Do not commit .env. Generate a random secret key locally, for example with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PONDLITE_ENV=production
PONDLITE_USERNAME=
PONDLITE_PASSWORD=
PONDLITE_SECRET_KEY=
PONDLITE_RUN_DIR=runs/demo/v5

